# Telegram
BOT_TOKEN=

# Google service account JSON path (must have Sheets + Vision API access)
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/sa.json

# ID of the master control spreadsheet that lists all campaigns
CONTROL_SHEET_ID=

# Comma-separated Telegram user IDs allowed to run /reload and other admin ops
SUPER_ADMIN_IDS=

# Local SQLite path (mount /data as a Fly volume in production)
SQLITE_PATH=/data/app.db

# Cache TTL for the campaigns control sheet (seconds)
CAMPAIGN_CACHE_TTL_SEC=300

# Timezone used when formatting timestamps written to Google Sheets
TZ=Asia/Ho_Chi_Minh

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
